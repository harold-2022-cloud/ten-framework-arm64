#!/usr/bin/env bash
# systemctl, faked. Every call is written to $FAKE_LOG as "systemctl ...".
# A unit exists when $FAKE_UNITS names it, and is active when $FAKE_ACTIVE
# does. qwen35-vllm runs serve_qwen35.sh exec ($FAKE_SERVE) and its start
# waits on serve_qwen35.sh ready, as the unit's ExecStartPost does;
# ambarella-llm runs a stand-in daemon named test_llm on $LLM_PORT and
# writes Device ENABLE to $DAEMON_LOG; starting either stops the other
# (Conflicts=). show reads $FAKE_DIR/units/<unit>.<property> when a test
# wrote one.
echo "systemctl $*" >> "$FAKE_LOG"
U="$FAKE_DIR/units"
mkdir -p "$U"

listed() { [[ " $2 " == *" $1 "* ]]; }
alive() { local pid; pid=$(cat "$U/$1.pid" 2>/dev/null) && kill -0 "$pid" 2>/dev/null; }
active() {
  listed "$1" "${FAKE_ACTIVE:-}" && return 0
  case "$1" in
    qwen35-vllm|ambarella-llm) alive "$1" ;;
    *) [[ -f "$U/$1.active" ]] ;;
  esac
}
stop_unit() {
  local pid
  rm -f "$U/$1.active"
  pid=$(cat "$U/$1.pid" 2>/dev/null) || return 0
  kill "$pid" 2>/dev/null
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -9 "$pid" 2>/dev/null
  rm -f "$U/$1.pid"
}
start_unit() {
  case "$1" in
    qwen35-vllm)
      stop_unit ambarella-llm
      alive qwen35-vllm && return 0
      "$FAKE_SERVE" exec </dev/null >/dev/null 2>&1 &
      echo $! > "$U/qwen35-vllm.pid"
      "$FAKE_SERVE" ready "${FAKE_READY_S:-30}"
      ;;
    ambarella-llm)
      stop_unit qwen35-vllm
      alive ambarella-llm && return 0
      "$FAKE_DIR/bin/test_llm" -m http.server "$LLM_PORT" --bind 127.0.0.1 </dev/null >/dev/null 2>&1 &
      echo $! > "$U/ambarella-llm.pid"
      echo "Device ENABLE" >> "$DAEMON_LOG"
      ;;
    *) touch "$U/$1.active" ;;
  esac
}

cmd="${1:-}"
shift
case "$cmd" in
  cat) listed "$1" "${FAKE_UNITS:-}" ;;
  is-active)
    quiet=0
    [[ "${1:-}" == --quiet ]] && { quiet=1; shift; }
    if active "$1"; then ((quiet)) || echo active; exit 0; fi
    ((quiet)) || echo inactive
    exit 3
    ;;
  is-enabled)
    if [[ -f "$U/$1.enabled" ]]; then echo enabled; exit 0; fi
    echo disabled
    exit 1
    ;;
  enable|disable)
    now=0
    for a in "$@"; do
      [[ "$a" == --now ]] && { now=1; continue; }
      if [[ $cmd == enable ]]; then
        touch "$U/$a.enabled"
        ((now)) && start_unit "$a"
      else
        rm -f "$U/$a.enabled"
        ((now)) && stop_unit "$a"
      fi
    done
    ;;
  start) for u in "$@"; do start_unit "$u" || exit 1; done ;;
  stop) for u in "$@"; do stop_unit "$u"; done ;;
  restart) for u in "$@"; do stop_unit "$u"; start_unit "$u" || exit 1; done ;;
  show)
    unit=""
    prop=""
    while (($#)); do
      case "$1" in
        -p) prop="$2"; shift 2 ;;
        --value) shift ;;
        *) unit="$1"; shift ;;
      esac
    done
    if [[ -f "$U/$unit.$prop" ]]; then
      cat "$U/$unit.$prop"
    elif [[ $prop == MainPID ]]; then
      if active "$unit" && [[ -f "$U/$unit.pid" ]]; then cat "$U/$unit.pid"; else echo 0; fi
    fi
    ;;
  status) echo "fake status $*" ;;
  daemon-reload|reset-failed) ;;
  *) echo "fake systemctl: $cmd is not faked" >&2; exit 1 ;;
esac
exit 0
