#!/usr/bin/env bash
# sudo, faked: runs the command as the caller. -v keeps nothing fresh; an
# install's -o/-g are dropped, since only root may give a file away.
case "${1:-}" in
  -v) exit 0 ;;
  -n) shift; [[ "${1:-}" == -v ]] && exit 0 ;;
esac
if [[ "${1:-}" == install ]]; then
  shift
  args=()
  while (($#)); do
    case "$1" in
      -o|-g) shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  exec install "${args[@]}"
fi
exec "$@"
