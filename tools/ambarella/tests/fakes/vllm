#!/usr/bin/env python3
# vllm serve, faked. Writes its arguments to $FAKE_DIR/vllm.argv; answers
# /v1/models after FAKE_LOAD_S (1); answers chat completions, plain or
# streamed, with a tool call when the request carries tools -- refused, as
# vLLM 0.9.2 refuses it, without --enable-auto-tool-choice. FAKE_EXIT exits
# at once; FAKE_NO_TOOL_FLAGS refuses tools whatever the arguments say (a
# vLLM on older ones); FAKE_TOOL_AS_TEXT writes the call as text, as an
# unparsed hermes call looks.
import json
import os
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

args = sys.argv[1:]
if os.environ.get("FAKE_DIR"):
    with open(os.path.join(os.environ["FAKE_DIR"], "vllm.argv"), "w", encoding="utf-8") as f:
        f.write("".join(a + "\n" for a in args))
if os.environ.get("FAKE_EXIT"):
    sys.exit(1)
port = int(args[args.index("--port") + 1])
tools_on = "--enable-auto-tool-choice" in args and not os.environ.get("FAKE_NO_TOOL_FLAGS")
time.sleep(float(os.environ.get("FAKE_LOAD_S", "1")))


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def send(self, code, body, kind="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):  # pylint: disable=invalid-name
        self.send(200, {"data": [{"id": "qwen3.5_4B"}]})

    def do_POST(self):  # pylint: disable=invalid-name
        req = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if req.get("tools") and not tools_on:
            self.send(400, {
                "object": "error", "type": "BadRequestError", "code": 400,
                "message": '"auto" tool choice requires --enable-auto-tool-choice '
                           "and --tool-call-parser to be set",
            })
            return
        if not req.get("stream"):
            self.send(200, {
                "choices": [{"message": {"content": "下周三开发布会。", "reasoning_content": None}}],
                "usage": {"completion_tokens": 8},
            })
            return
        deltas = [{"content": "好的。"}]
        if req.get("tools"):
            call = {"name": "get_future_weather", "arguments": json.dumps({"location": "Shanghai"})}
            if os.environ.get("FAKE_TOOL_AS_TEXT"):
                deltas = [{"content": "<tool_call>" + json.dumps(call) + "</tool_call>"}]
            else:
                deltas = [
                    {"tool_calls": [{"index": 0, "id": "call_1", "type": "function",
                                     "function": {"name": call["name"], "arguments": ""}}]},
                    {"tool_calls": [{"index": 0, "function": {"arguments": call["arguments"]}}]},
                ]
        body = b"".join(
            b"data: " + json.dumps({"choices": [{"index": 0, "delta": d}]}, ensure_ascii=False).encode()
            + b"\n\n"
            for d in deltas
        ) + b"data: [DONE]\n\n"
        self.send(200, body, "text/event-stream")


ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
